msgctxt "blurb"
msgid "Delphine is a Mozilla Fellow helping African journalists identify cultural bias in AI."
msgstr "delphine es una becaria de Mozilla que ayuda a los periodistas africanos a identificar sesgos culturales en la IA."

msgctxt "quote"
msgid "The single story creates stereotypes, and the problem with stereotypes is not that they are untrue, but that they are incomplete."
msgstr "La historia única crea estereotipos y el problema con los estereotipos no es que sean falsos, sino que son incompletos."

msgctxt "quote_attribution"
msgid "Chimamanda Ngozi Adichie"
msgstr "Chimamanda Ngozi Adichie"
