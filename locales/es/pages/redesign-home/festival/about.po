msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.a95e876b-af09-4d34-8c3d-6cf4e9232107.title"
msgid "Retuning to the Source"
msgstr "Regreso a los orígenes"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.a95e876b-af09-4d34-8c3d-6cf4e9232107.description"
msgid "Fifteen years after Drumbeat, MozFest returned to Barcelona as a global, in-person event. Together, we unlearned the defaults and built bolder alternatives."
msgstr "Quince años después de Drumbeat, el MozFest volvió a Barcelona como un evento global presencial. Juntos, desaprendimos las dinámicas preestablecidas y creamos alternativas más audaces."

