msgstr "Círculo de apertura del MozFest 2021"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.c299330d-3947-4429-b016-1023fbf92191.header"
msgid "2021"
msgstr "2021"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.c299330d-3947-4429-b016-1023fbf92191.title"
msgid "The New Normal"
msgstr "La nueva normalidad"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.c299330d-3947-4429-b016-1023fbf92191.description"
msgid "When connection was needed most, MozFest shifted to a virtual format, uniting over 10,000 participants across 12 days of community-led experiences."
msgstr "Cuando más necesitábamos conectarnos, el MozFest cambió a un formato virtual que unió a más de 10.000 participantes a lo largo de 12 días de experiencias dirigidas por la comunidad."

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.6f5167c6-8461-4b50-a95c-d695a0d96d1e.image.alt_text"
