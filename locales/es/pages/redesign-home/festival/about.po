msgstr "2016"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.c5eedd4b-5abc-44e0-a091-ffc43b430ab8.title"
msgid "Immersive Experiences"
msgstr "Experiencias inmersivas"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.c5eedd4b-5abc-44e0-a091-ffc43b430ab8.description"
msgid "Storytelling and art became central to MozFest, with MozEx and Dialogues &amp; Debates creating spaces that sparked inspiration and collaboration through creativity."
msgstr ""
"La narración de historias y el arte se convirtieron en elementos centrales del MozFest; las secciones «MozEx» y «Diálogos y debates» crearon espacios para inspirar y promover la colaboración a "
"través de la creatividad."

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.1fc57416-d481-448d-b955-7d553b561e6d.image.alt_text"
