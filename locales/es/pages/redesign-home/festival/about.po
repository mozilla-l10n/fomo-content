msgstr "2018-MakingItPersonal"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.1fc57416-d481-448d-b955-7d553b561e6d.header"
msgid "2018"
msgstr "2018"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.1fc57416-d481-448d-b955-7d553b561e6d.title"
msgid "Making It Personal"
msgstr "Lo hicimos personal"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.1fc57416-d481-448d-b955-7d553b561e6d.description"
msgid "Ethical AI and data privacy became personal missions. MozFest wove these themes into every corner, making the fight for the web a shared journey."
msgstr "La IA ética y la privacidad de los datos se convirtieron en misiones personales. El MozFest entretejió estos temas en cada rincón, haciendo de la lucha por la web un viaje compartido."

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.c299330d-3947-4429-b016-1023fbf92191.image.alt_text"
