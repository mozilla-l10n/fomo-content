msgstr "Actualizamos estas preguntas frecuentes periódicamente a medida que recibimos nuevas consultas."

msgctxt "body.71a07001-9208-4062-abcf-3c9a36d0a7dc"
msgid "If neither this FAQ nor the call for proposals answers your question, email us at"
msgstr "Si no encuentras la respuesta a tus preguntas ni en esta sección ni la convocatoria de propuestas, escríbenos a"

msgctxt "body.71a07001-9208-4062-abcf-3c9a36d0a7dc"
msgid "incubator@mozillafoundation.org"
msgstr "incubator@mozillafoundation.org"

msgctxt "body.71a07001-9208-4062-abcf-3c9a36d0a7dc"
