msgstr "<a id=\"a1\">J’ai été arrêté pour avoir aidé des Kényans à envoyer des e-mails au Parlement</a>"

msgctxt "bio"
msgid "<a id=\"a1\">Surveillance State: Are you safe? Are you next?</a>"
msgstr "<a id=\"a1\">État de surveillance : Êtes-vous en sécurité ? Quand viendra votre tour ?</a>"

