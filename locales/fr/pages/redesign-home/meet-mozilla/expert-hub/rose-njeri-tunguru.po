msgstr "<a id=\"a1\">Mes réflexions sur la rencontre nationale d’Okoa Uchumi consacrée au financement d’un budget de 4,8 billions de shillings kényans</a>"

msgctxt "bio"
msgid "<a id=\"a1\">We Keep Showing Up. Is Parliament Listening?</a>"
msgstr "<a id=\"a1\">Nous continuons de nous mobiliser. Le Parlement nous écoute-t-il ?</a>"

