msgid "<a id=\"a1\">“We are living a technological revolution.”</a> XR Magazine"
msgstr "<a id=\"a1\">« Nous vivons une révolution technologique. »</a> XR Magazine"

msgctxt "bio"
msgid "<a id=\"a1\">“I believe in the near future the access to artificial intelligence is going to be a human right.”</a> <i>XR Magazine</i>"
msgstr "<a id=\"a1\">« Je suis convaincu que l’accès à l’intelligence artificielle deviendra bientôt un droit humain. »</a> <i>XR Magazine</i>"

