msgid "Arghya Bhattacharya,<a id=\"a1\"> Adalat AI</a>"
msgstr "Arghya Bhattacharya,<a id=\"a1\"> Adalat AI</a>"

msgctxt "body.5f938b0c-f743-460a-a69f-4d020e0845eb.left_column.e8d6c467-5938-4d8a-a382-2de9aa1c80d8"
msgid "Danielle Bennett,<a id=\"a1\"> CliveRd</a>"
msgstr "Danielle Bennett,<a id=\"a1\"> CliveRd</a>"

msgctxt "body.5f938b0c-f743-460a-a69f-4d020e0845eb.left_column.e8d6c467-5938-4d8a-a382-2de9aa1c80d8"
msgid "Daniel Brumund,<a id=\"a1\"> GIZ</a>"
msgstr "Daniel Brumund,<a id=\"a1\"> GIZ</a>"

msgctxt "body.5f938b0c-f743-460a-a69f-4d020e0845eb.left_column.e8d6c467-5938-4d8a-a382-2de9aa1c80d8"
