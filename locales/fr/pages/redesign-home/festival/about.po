msgid "2010"
msgstr "2010"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.b1c6f92c-0da3-48fe-8738-22e340b93a8f.title"
msgid "Finding Our Rhythm"
msgstr "Trouver notre rythme"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.b1c6f92c-0da3-48fe-8738-22e340b93a8f.description"
msgid "MozFest began as Drumbeat Festival, a convening of leaders in Barcelona making radical disruptions in learning and in web technology."
msgstr ""
"Le MozFest a vu le jour sous le nom de Drumbeat Festival, un rassemblement à Barcelone réunissant des acteurs de premier plan à l’origine de bouleversements radicaux dans les domaines de l’éducation"
" et des technologies du Web."

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.43c07235-739b-4ae1-9cb5-611fa405fc98.image.alt_text"
