msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.6f5167c6-8461-4b50-a95c-d695a0d96d1e.title"
msgid "Many Houses, One Movement"
msgstr "Plusieurs maisons, un seul mouvement"

msgctxt "body.5b74dcc8-c014-4180-b956-cf15ddd26a9f.items.6f5167c6-8461-4b50-a95c-d695a0d96d1e.description"
msgid "From Amsterdam to Nairobi to Lusaka, MozFest House brought the festival closer to communities building better technology from the ground up."
msgstr "D’Amsterdam à Nairobi en passant par Lusaka, le MozFest House a permis de rapprocher le festival des communautés qui développent des technologies plus performantes en partant de zéro."

