msgstr "Jeśli nie znajdziesz odpowiedzi na swoje pytanie ani w tej sekcji FAQ, ani w ogłoszeniu o naborze wniosków, napisz do nas na adres"

msgctxt "body.71a07001-9208-4062-abcf-3c9a36d0a7dc"
msgid "incubator@mozillafoundation.org"
msgstr "incubator@mozillafoundation.org"

msgctxt "body.71a07001-9208-4062-abcf-3c9a36d0a7dc"
