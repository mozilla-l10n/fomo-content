msgctxt "seo_title"
msgid "Donate Now"
msgstr ""

msgctxt "search_description"
msgid ""
"We are proudly non-profit, non-corporate and non-compromised. Thousands of people like you help us stand up for a healthy internet for all. We rely on donations to carry out our mission to keep the "
"Web open and free. Will you give today?"
msgstr ""

msgctxt "title"
msgid "Give Today. Build What Comes Next."
msgstr ""

msgctxt "hero_title"
msgid "Give Today. Build What Comes Next."
msgstr ""

msgctxt "body.38be4c42-e634-4c9a-9605-b804c000fc28.left_column.2b912452-f231-4b95-929d-cd9769b47ba1.image.alt_text"
msgid "Media (8)"
msgstr ""

msgctxt "body.38be4c42-e634-4c9a-9605-b804c000fc28.right_column.ee29a5d2-6aee-4a78-88e5-f5a8ebefea10.fru_element_embed_code"
