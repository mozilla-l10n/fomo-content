msgstr "<a id=\"a1\">I was arrested for helping Kenyans email parliament [Fui presa por ajudar quenianos a enviar e-mails ao parlamento]</a>"

msgctxt "bio"
msgid "<a id=\"a1\">Surveillance State: Are you safe? Are you next?</a>"
msgstr "<a id=\"a1\">Surveillance State: Are you safe? Are you next? [Estado de vigilância: você está seguro? Você será o próximo?]</a>"

