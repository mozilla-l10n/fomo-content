msgstr "<a id=\"a1\">\"Small AI\"</a> — AI x Design"

msgctxt "body.9ead5a3f-f999-4699-8957-29c812f9319e.accordion_items.ef22bbf1-028d-46b2-aee5-5dcd0a3f1b73.content.f9e547ce-20f2-4093-8324-1921ca9b4bdc"
