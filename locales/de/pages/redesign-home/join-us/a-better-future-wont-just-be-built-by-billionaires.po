msgctxt "body.e3bcd448-c325-4b52-958a-a506a6f6e23e.items.885fab8c-3eaa-4cdb-b551-99a45efa028d.image.alt_text"
msgid "Orange poster with a high-contrast black halftone photo of a young man with shoulder-length locs looking directly at the camera. Text reads: \"Rudy builds Blacksky. Communities call the shots.\""
msgstr ""
"Orangefarbenes Poster mit einem kontrastreichen schwarzen Rasterfoto eines jungen Mannes mit schulterlangen Locs, der direkt in die Kamera blickt. Darauf steht: „Rudy builds Blacksky. Communities "
"call the shots.“"

msgctxt "body.e3bcd448-c325-4b52-958a-a506a6f6e23e.items.051e5a15-0c0d-47b5-b492-5e14e1048ae3.image.alt_text"
msgid "White poster with bold black text reading: \"Wannabe kings don't rule the internet. We all do.\" Mozilla Foundation logo at the bottom."
msgstr "Weißes Poster mit fetter schwarzer Aufschrift: „Wannabe kings don't rule the internet. We all do.“ Unten ist das Logo der Mozilla Foundation zu sehen."

