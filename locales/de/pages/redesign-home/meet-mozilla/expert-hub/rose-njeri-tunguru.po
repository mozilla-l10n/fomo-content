msgid "<a id=\"a1\">I was arrested for helping Kenyans email parliament</a>"
msgstr "<a id=\"a1\">Ich wurde verhaftet, weil ich Kenianer*innen geholfen habe, dem Parlament E-Mails zu senden</a>"

msgctxt "bio"
msgid "<a id=\"a1\">Surveillance State: Are you safe? Are you next?</a>"
msgstr "<a id=\"a1\">Überwachungsstaat: Sind Sie sicher? Sind Sie der Nächste?</a>"

