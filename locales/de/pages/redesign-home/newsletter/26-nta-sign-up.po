msgctxt "body.46cf9fe6-5b6c-499c-941e-b84371963df1.left_column.740a3b03-ffe8-412c-ba9e-67cd4700e22b.image.alt_text"
msgid "A group of MozFest Wranglers, discussing ideas and using sticky notes to mind map on a board."
msgstr "Eine Gruppe von MozFest-Wranglern, die Ideen diskutieren und Notizen verwenden, um eine Mind-Map auf einem Forum zu erstellen."

msgctxt "body.46cf9fe6-5b6c-499c-941e-b84371963df1.left_column.28413cb2-f288-400e-ab38-f6ed0e975701"
msgid ""
"The Internet is built by people like you. By joining our community, you’re joining a movement that is making good tech the default. Together we’ll advance trustworthy technology, digital rights, and"
" stand for an Internet that lifts us all."
msgstr ""
